  "interpretation": "Country coverage, not accuracy. Inferred country remains marked by classification_jurisdiction or classification_reporter_consensus. Identity confidence is unchanged.",
  "decision_review": [
    {
      "layer": "extraction",
      "action": "retained",
      "reason": "Structural candidate matching; no country or DD prerequisite. Missing shapes require separate extraction changes."
    },
    {
      "layer": "classification",
      "action": "retained",
      "reason": "Non-case/date/statute exclusions and same-grade conflicting readings prevent double counting; case-name rejection is separate from citation admission."
    },
    {
      "layer": "member_country",
      "action": "changed",
      "reason": "Accepted jurisdiction classifications now supply country without a second exclusive-source requirement. Reporter candidates that differ only within one country also determine country. Explicit case/scope conclusions and country conflicts take precedence."
    },
    {
      "layer": "group_country",
      "action": "changed",
      "reason": "All member country observations participate; identity basis does not erase country. Different countries remain conflicts."
    },
    {
      "layer": "edge_country",
      "action": "changed",
      "reason": "A source citation uses its own member country independently of identity confidence. Group-only propagation still needs an identity-supported path."
    },
    {
      "layer": "identity",
      "action": "retained",
      "reason": "Distinct neutral judgments, positive incompatible courts, self-citation exclusion, date windows and exact identity conflicts guard case identity, not country assessment."
    },
    {
      "layer": "selection",
      "action": "changed",
      "reason": "Default DD >= 1 retains all counted groups; DD >= 5 is an optional frequent profile, not case validity."
    },
    {
      "layer": "research",
      "action": "changed",
      "reason": "Country coverage no longer requires identity-supported edges. Unknown/conflict and identity support have separate denominators."
    }
  ]
