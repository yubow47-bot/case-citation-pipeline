# Shell scripts must keep LF line endings even when git runs with core.autocrlf=true
# on Windows, otherwise bash reads the trailing CR as part of file names.
*.sh text eol=lf

# Published review checksums require identical bytes on every platform.
/audit/findings/quality_model_review_20261015/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# The offline ledger checker enforces the maintenance helper CRLF contract.
/PROBLEMS.md text eol=crlf
